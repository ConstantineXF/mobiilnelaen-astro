---
import '../styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import InstallPwa from '../components/InstallPwa.astro';
import QrOpen from '../components/QrOpen.astro';
import { ogFileFor } from '../../scripts/og-slug.mjs';

interface Props {
  title: string;
  description?: string;
  /** Абсолютный или относительный canonical; по умолчанию — текущий URL без query. */
  canonical?: string;
  image?: string;
  noindex?: boolean;
  /** Кредитный продукт страницы → schema LoanOrCredit */
  loanProduct?: { name: string; loanType?: string; min?: number; max?: number };
  /** Хлебные крошки → schema BreadcrumbList */
  breadcrumbs?: { name: string; url: string }[];
}

// ВАЖНО: хост должен совпадать с тем, что реально отдаёт сервер.
// Non-www 307-редиректится на www, поэтому canonical/og/sitemap = www,
// иначе все canonical указывают на редирект и сигналы размазываются.
const SITE_URL = 'https://www.mobiilnelaen.ee';

const {
  title,
  description = 'Mobiilne Laen — võrdle Eesti parimaid laenupakkumisi ühel lehel: kiirlaen, väikelaen, krediidikonto ja krediitkaart.',
  canonical,
  image,
  noindex = false,
  loanProduct,
  breadcrumbs,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE_URL).href;

// OG-картинка по формуле: своя на страницу, генерится scripts/generate-og.mjs.
// Имя файла и alt несут ключи (см. память: reference_og_image_formula).
// ⭐ 03.08.2026: правило именования и список страниц переехали в общий модуль
// scripts/og-slug.mjs — им пользуется и генератор. Главная теперь отдаёт
// /og/mobiilne-laen.png вместо index.png: og:image индексируется поиском по
// картинкам как самостоятельный ресурс, и имя файла работает как ключ.
const autoOg = ogFileFor(Astro.url.pathname);
const imageUrl = new URL(image ?? autoOg, SITE_URL).href;
const imageAlt = `${title.split('—')[0].trim()} — MobiilneLaen.ee`;

// индексируется и сам по себе (у sesok.ee картинка в выдаче есть при нуле
// тегов <img>), но <img> — основной канал обнаружения для Google Images, и alt
// там реально влияет, тогда как og:image:alt читают только соцсети и
// скринридеры. ⛔ Прятать картинку CSS-ом нельзя: только видимый элемент.
const ogFigureAlt = `${title.split('—')[0].trim()} — laenutingimuste ja KKM-i võrdlus nutiseadmes`;

// ── Schema.org @graph: Organization + WebSite (+ LoanOrCredit / BreadcrumbList) ──
const schemaGraph: Record<string, any> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'MobiilneLaen.ee',
      url: SITE_URL,
      logo: `${SITE_URL}/icon.svg`,
      description:
        'Sõltumatu laenude võrdlusportaal Eestis: mobiilne laen, sms-laen, kiirlaen, väikelaen, krediidikonto ja krediidiliin.',
      areaServed: { '@type': 'Country', name: 'Estonia' },
      email: 'info@mobiilnelaen.ee',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: 'MobiilneLaen.ee',
      publisher: { '@id': `${SITE_URL}/#organization` },
      inLanguage: 'et-EE',
    },
  ],
};

if (loanProduct) {
  schemaGraph['@graph'].push({
    '@type': 'LoanOrCredit',
    '@id': `${canonicalUrl}#loan`,
    name: loanProduct.name,
    url: canonicalUrl,
    loanType: loanProduct.loanType ?? loanProduct.name,
    currency: 'EUR',
    ...(loanProduct.min || loanProduct.max
      ? {
          amount: {
            '@type': 'MonetaryAmount',
            currency: 'EUR',
            ...(loanProduct.min ? { minValue: loanProduct.min } : {}),
            ...(loanProduct.max ? { maxValue: loanProduct.max } : {}),
          },
        }
      : {}),
    areaServed: { '@type': 'Country', name: 'Estonia' },
    provider: { '@id': `${SITE_URL}/#organization` },
  });
}

if (breadcrumbs?.length) {
  schemaGraph['@graph'].push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, SITE_URL).href,
    })),
  });
}
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* PWA */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#06b6d4" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MobiilneLaen" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MobiilneLaen.ee" />
    <meta property="og:locale" content="et_EE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={imageAlt} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Базовые схемы сайта: Organization + WebSite (+ LoanOrCredit/Breadcrumb по странице) */}
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    {/* Дополнительные теги/схемы из страниц */}
    <slot name="head" />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <Header />
    <main>
      <slot />
      
    </main>
    <Footer />
    <CookieConsent />
    <InstallPwa />
    <QrOpen />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
    <!-- Network stats beacon → first-party /api/n-c (relays server-side; no shared host) -->
    <script is:inline>(function(){function s(k){try{navigator.sendBeacon('/api/n-c',JSON.stringify({p:location.pathname,k:k}))}catch(e){}}s('view');document.addEventListener('click',function(e){var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;if(!a)return;var h=a.hostname;if(h&&h!==location.hostname){s('click')}},true);})();</script>
  </body>
</html>
